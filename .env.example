# --- Server ---
PORT=4100
# Origin yang boleh mengakses. Isi dengan domain web saat produksi.
CORS_ORIGIN=*
# URL publik server ini; dipakai menyusun tautan gambar yang disiarkan.
PUBLIC_URL=http://localhost:4100

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wishing_wall
DB_USER=postgres
DB_PASSWORD=
# Isi true jika Postgres mewajibkan SSL (mis. layanan cloud).
DB_SSL=false
